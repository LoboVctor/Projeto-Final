# =============================================================
# ELO API — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env e preencha com seus valores.
#   cp .env.example .env
#
# ATENÇÃO: Nunca commite o arquivo .env no repositório.
# =============================================================

# --- Banco de Dados ---
# String de conexão PostgreSQL.
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<banco>?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/ELO?schema=public"

# --- Autenticação JWT ---
# Chave secreta usada para assinar os tokens JWT.
# Use uma string longa e aleatória em produção (ex: openssl rand -hex 64).
JWT_SECRET="troque-por-uma-chave-secreta-forte"

# Tempo de expiração do token JWT (ex: 12h, 1d, 7d).
JWT_EXPIRES_IN="12h"

# --- Servidor ---
# Porta em que a API vai escutar. Padrão: 3000.
PORT=3000

# --- CORS ---
# Origens permitidas para requisições cross-origin, separadas por vírgula.
# Em desenvolvimento, geralmente o endereço do front-end Angular.
CORS_ORIGIN="http://localhost:4200"
